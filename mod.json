  "settings": {
    "terminal-title": {
      "type": "title",
      "name": "terminal",
      "description": "terminal window options",
      "platforms": [
        "win",
        "mac"
      ]
    },
    "terminal-enabled": {
      "type": "bool",
      "name": "enable terminal",
      "description": "show the terminal button in the dynamic control panel",
      "default": true,
      "platforms": [
        "win",
        "mac"
      ]
    },
    "keybinds-title": {
      "type": "title",
      "name": "keybinds",
      "description": "change geodes keybinding anytime for dynamic",
      "platforms": [
        "win",
        "mac"
      ]
    },
    "keybind-stage": {
      "type": "keybind",
      "name": "cycle stages",
      "description": "cycle prediction stages",
      "category": "gameplay",
      "default": [
        "F6"
      ],
      "platforms": [
        "win",
        "mac"
      ]
    },
    "keybind-terminal": {
      "type": "keybind",
      "name": "control panel",
      "description": "open or close the dynamic control panel",
      "category": "universal",
      "default": [
        "F9"
      ],
      "platforms": [
        "win",
        "mac"
      ]
    },
    "ui-title": {
      "type": "title",
      "name": "ui customization",
      "description": "customize the control panel appearance"
    },
    "ui-primary-color": {
      "type": "color",
      "name": "primary color",
      "description": "primary gradient color for the panel",
      "default": "#A855F7"
    },
    "ui-secondary-color": {
      "type": "color",
      "name": "secondary color",
      "description": "secondary gradient color for the panel",
      "default": "#D5B4FF"
    },
    "ui-surface-color": {
      "type": "color",
      "name": "surface color",
      "description": "background color of the panel card",
      "default": "#17131F"
    },
    "ui-text-color": {
      "type": "color",
      "name": "text color",
      "description": "color used for all panel text",
      "default": "#EFE7F7"
    },
    "ui-glow": {
      "type": "bool",
      "name": "glow",
      "description": "draw a soft accent glow behind the panel",
      "default": true
    },
    "ui-panel-scale": {
      "type": "float",
      "name": "panel scale",
      "description": "adjust the overall size of the control panel",
      "default": 0.7,
      "min": 0.4,
      "max": 2.0,
      "step": 0.05
    },
    "ui-font-scale": {
      "type": "float",
      "name": "font scale",
      "description": "adjust the text size in the control panel",
      "default": 1.5,
      "min": 0.8,
      "max": 2.0,
      "step": 0.05
    },
    "mobile-title": {
      "type": "title",
      "name": "mobile",
      "description": "android and ios options",
      "platforms": [
        "android",
        "ios"
      ]
    },
    "mobile-floating-button": {
      "type": "bool",
      "name": "floating dynamic button",
      "description": "also show the draggable dynamic button on screen. the pause menu button is always there",
      "default": false,
      "platforms": [
        "android",
        "ios"
      ]
    }
  }
}
